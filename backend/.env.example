# SaaS branch: use the local tenant-kit sample schema, never an existing SGS/SSS DB.
# Both URLs must refer to the same shared database and a non-bypass application role.
DATABASE_URL=postgresql://saraswati_student_app:change_me@localhost:5432/saraswati_sample
SARASWATI_DATABASE_URL=postgresql://saraswati_student_app:change_me@localhost:5432/saraswati_sample
# Resolver reads platform tables before a school is bound. Defaults to the shared URL.
SARASWATI_CONTROL_DATABASE_URL=postgresql://saraswati_student_app:change_me@localhost:5432/saraswati_sample
CLIENT_NAME=Student
# Total worker/service slots sharing the database, not a per-pool connection count.
# Production: 12. Staging: 40. Restart the backend after changing these settings.
DB_SERVICE_SLOTS=12
DB_POOL_RESERVE=0.2
CORS_ALLOW_ORIGINS=http://sgs.localhost:3004,http://sss.localhost:3004
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-private-bucket-name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
# Required only when AWS provides temporary credentials.
AWS_SESSION_TOKEN=
AWS_S3_PRESIGNED_URL_EXPIRY=3600
