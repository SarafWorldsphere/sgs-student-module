DATABASE_URL=postgresql://sgs_app_user:change_me@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/sgs_db
CLIENT_NAME=SGS
# Total worker/service slots sharing the database, not a per-pool connection count.
# Production: 12. Staging: 40. Restart the backend after changing these settings.
DB_SERVICE_SLOTS=12
DB_POOL_RESERVE=0.2
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3004,http://127.0.0.1:3000,http://127.0.0.1:3004,http://your-ec2-public-ip:84
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-private-bucket-name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
# Required only when AWS provides temporary credentials.
AWS_SESSION_TOKEN=
AWS_S3_PRESIGNED_URL_EXPIRY=3600
